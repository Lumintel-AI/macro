FROM rust:1.94-trixie AS chef
ENV SQLX_OFFLINE=true CARGO_BUILD_JOBS=2
# Build native dependencies pulled in by workspace-hack, including librdkafka.
RUN apt-get update && apt-get install -y --no-install-recommends \
  cmake \
  clang \
  libclang-dev \
  pkg-config \
  libssl-dev \
  libcurl4-openssl-dev \
  libglib2.0-dev \
  liblzma-dev \
  protobuf-compiler \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*
RUN cargo install --locked cargo-chef cargo-strip
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare  --recipe-path recipe.json --bin search_processing_service

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Cargo patches this crate to a local path during dependency resolution.
COPY --from=planner /app/vendor /app/vendor
# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --recipe-path recipe.json --bin search_processing_service
# Build application
COPY . .
RUN cargo build --locked --release --bin search_processing_service && \
  cargo strip && \
  mv /app/target/release/search_processing_service /app/svc

FROM debian:trixie-slim AS runner
WORKDIR /app

RUN : \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
  ca-certificates \
  dumb-init \
  libstdc++6 \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 --from=builder /app/svc /app/svc

RUN mkdir -p /app/pdfium-lib/linux
COPY --from=builder /app/services/search_processing_service/pdfium-lib/linux/libpdfium.so /app/pdfium-lib/linux/libpdfium.so

# Check PDFium and both ELF dependency sets inside the final runtime.
RUN test -s /app/pdfium-lib/linux/libpdfium.so \
  && ldd /app/svc > /tmp/svc-ldd.txt \
  && ldd /app/pdfium-lib/linux/libpdfium.so > /tmp/pdfium-ldd.txt \
  && cat /tmp/svc-ldd.txt /tmp/pdfium-ldd.txt \
  && ! grep -q 'not found' /tmp/svc-ldd.txt /tmp/pdfium-ldd.txt

ENV PORT=8080
EXPOSE ${PORT}

ENTRYPOINT ["dumb-init", "./svc"]
