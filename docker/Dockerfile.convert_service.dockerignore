# Version-control and local-agent state
.git
.jj
.agents
.cursor
.claude/.local
.pi/outputs
/infra/local/generated

# Legacy layout directories may still contain ignored local build artifacts.
/agents
/js
/rust

# User-facing applications and shared JavaScript packages are not part of most
# backend service build contexts. The lexical service has a Dockerfile-specific
# ignore file because it installs the root JavaScript workspace.
/apps
/packages

# Rust modules also live in directories named build. Keep source trees.
**/build
!**/src/**/build
!**/src/**/build/**

# Secrets and local configuration
.env
.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.dev.vars*

# Dependency and generated output
**/node_modules
**/target
**/dist
**/.wrangler
**/test-results
**/playwright-report
**/coverage
**/.cache
**/.vite
**/*.tsbuildinfo
**/*.log

# Editor and operating-system noise
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo

# Never send local credentials to the builder.
**/*.pem
**/*.key
**/credentials*
# Rust modules named credentials are source code, not secrets.
!**/src/**/credentials.rs
!**/src/**/credentials
!**/src/**/credentials/**
**/.aws
**/.ssh
# lexical_client embeds this public local-dev CA certificate (no key) at compile time.
!infra/local/certs/ca.pem
